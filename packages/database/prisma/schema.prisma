// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  profile   Profile?
  
  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  avatar    String?
  level     Int      @default(1)
  experience Int     @default(0)
  coins     Int      @default(100)
  farmName  String?
  createdAt DateTime @default(now())
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plots Plot[]
  
  @@map("profiles")
}

model Plot {
  id        String   @id @default(cuid())
  profileId String
  index     Int      // Posição no grid (0, 1, 2...)
  cropType  String?  // 'carrot', 'corn', etc.
  plantedAt DateTime?
  isUnlocked Boolean @default(false)
  
  profile   Profile  @relation(fields: [profileId], references: [id])
  crop      Crop?    @relation(fields: [cropType], references: [slug])

  @@unique([profileId, index]) // Um jogador não pode ter dois terrenos na mesma posição
  @@map("plots")
}

model Crop {
  id            String   @id @default(cuid())
  name          String   @unique // ex: "Cenoura"
  slug          String   @unique // ex: "carrot" (usado para achar a sprite)
  
  // Economia
  price         Int      // Custo para plantar
  sellPrice     Int      // Valor de venda ao colher
  xpReward      Int      // Experiência ganha
  
  // Tempo
  growthTime    Int      // Tempo em segundos
  
  // Requisito
  minLevel      Int      @default(1)
  
  plots         Plot[]   // Relação com os terrenos
  
  @@map("crops")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // 'plant', 'harvest', 'unlock_plot', 'level_up'
  description String   // "Lucas plantou Cenoura no Plot 3"
  metadata    Json?    // Dados adicionais: { cropSlug: "carrot", plotIndex: 3, coins: 50 }
  createdAt   DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}
