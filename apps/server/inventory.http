### Inventory API Tests

# 1. Login para obter token
# @name login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "123456"
}

###

@token = {{ login.response.body.access_token }}

###

# 2. Obter todo o inventário do jogador
GET http://localhost:3000/inventory
Authorization: Bearer {{token}}

###

# 3. Filtrar inventário apenas por sementes
GET http://localhost:3000/inventory?type=SEED
Authorization: Bearer {{token}}

###

# 4. Filtrar inventário apenas por colheitas colhidas
GET http://localhost:3000/inventory?type=CROP
Authorization: Bearer {{token}}

###

# 5. Vender colheitas ou itens do inventário
POST http://localhost:3000/inventory/sell
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "itemSlug": "wheat",
  "quantity": 1
}
