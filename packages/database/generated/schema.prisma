// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile Profile?

  @@map("users")
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  avatar     String?
  level      Int      @default(1)
  experience Int      @default(0)
  coins      Int      @default(100)
  farmName   String?
  createdAt  DateTime @default(now())

  // Relations
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plots     Plot[]
  inventory InventoryItem[]
  animals   Animal[]

  @@map("profiles")
}

model Plot {
  id         String    @id @default(cuid())
  profileId  String
  index      Int // Posição no grid (0, 1, 2...)
  cropType   String? // 'wheat_seed', 'carrot_seed', etc.
  plantedAt  DateTime?
  isUnlocked Boolean   @default(false)

  profile Profile @relation(fields: [profileId], references: [id])
  crop    Item?   @relation("PlotToCrop", fields: [cropType], references: [slug])

  @@unique([profileId, index]) // Um jogador não pode ter dois terrenos na mesma posição
  @@map("plots")
}

model Item {
  id          String  @id @default(cuid())
  slug        String  @unique // ex: 'wheat_seed', 'wheat', 'fertilizer_speed', 'chicken'
  name        String // ex: "Semente de Trigo", "Trigo", "Galinha"
  description String?
  type        String // 'SEED', 'CROP', 'FERTILIZER', 'TOOL', 'ANIMAL', 'FOOD', 'ANIMAL_PRODUCT'

  // Economia
  buyPrice  Int @default(0) // Custo para comprar na loja
  sellPrice Int @default(0) // Valor de venda
  minLevel  Int @default(1) // Nível necessário para comprar/usar

  // Atributos específicos para cultivo (quando type == 'SEED')
  growthTime    Int? // Tempo em segundos
  xpReward      Int? // XP concedido ao colher
  yieldItemSlug String? // Slug do fruto que essa semente gera (ex: 'wheat')

  // Atributos específicos para animais (quando type == 'ANIMAL')
  productionTime Int? // Tempo para produzir após ser alimentado (segundos)
  foodSlug       String? // Comida que consome (ex: 'chicken_feed')
  foodQuantity   Int? // Quantidade de comida por alimentação
  maxWeight      Int? // Peso máximo para venda (apenas porcos)
  weightGain     Int? // Quanto ganha por alimentação (apenas porcos)

  inventoryItems InventoryItem[]
  plots          Plot[]          @relation("PlotToCrop")
  animals        Animal[]        @relation("AnimalToAnimal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String // 'plant', 'harvest', 'unlock_plot', 'level_up'
  description String // "Lucas plantou Cenoura no Plot 3"
  metadata    Json? // Dados adicionais: { cropSlug: "carrot", plotIndex: 3, coins: 50 }
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

model Animal {
  id         String    @id @default(cuid())
  profileId  String
  animalSlug String // 'chicken', 'pig', 'cow'
  fedAt      DateTime? // Última vez que foi alimentado
  weight     Int? // Peso atual (apenas para porcos, kg)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  animal  Item?   @relation("AnimalToAnimal", fields: [animalSlug], references: [slug])

  @@unique([profileId, animalSlug]) // 1 animal por tipo por perfil
  @@index([profileId])
  @@map("animals")
}

model InventoryItem {
  id        String   @id @default(cuid())
  profileId String
  itemSlug  String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemSlug], references: [slug], onDelete: Cascade)

  @@unique([profileId, itemSlug])
  @@index([profileId])
  @@map("inventory_items")
}
